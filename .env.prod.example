# Copy to .env.prod.local, chmod 600, and replace every required value.
VOVREMYA_IMAGE_TAG=replace-with-git-sha
APP_DOMAIN=vovremya.example.com
ACME_EMAIL=admin@example.com

APP_SECRET=replace-with-at-least-32-random-characters
DEFAULT_URI=https://vovremya.example.com
SYMFONY_TRUSTED_PROXIES=REMOTE_ADDR
DATABASE_URL=postgresql://vovremya:replace-with-url-encoded-password@postgres:5432/vovremya?serverVersion=17&charset=utf8
POSTGRES_PASSWORD=replace-with-the-same-raw-password
REDIS_URL=redis://redis:6379
MESSENGER_TRANSPORT_DSN=redis://redis:6379
MESSENGER_CONSUMER_NAME=vovremya_php

INFRASTRUCTURE_HEARTBEAT_INTERVAL="5 minutes"
REGULAR_SCHEDULE_HORIZON_DAYS=60
CHANNEL_ACTIVATION_TTL_SECONDS=1800

MAX_API_BASE_URL=https://platform-api2.max.ru
MAX_BOT_TOKEN=
MAX_BOT_USERNAME=
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
WHATSAPP_GRAPH_API_BASE_URL=https://graph.facebook.com
WHATSAPP_GRAPH_API_VERSION=v26.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_BUSINESS_PHONE=
