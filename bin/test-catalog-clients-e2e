#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
run_id="$(date +%s)-$$"
trap 'docker compose exec -T php php tests/Fixtures/catalog_clients.php remove "$run_id"' EXIT
docker compose exec -T php php bin/console doctrine:migrations:migrate --no-interaction
docker compose exec -T php php tests/Fixtures/catalog_clients.php create "$run_id"
docker compose --profile test run --rm -e DIRECTORY_E2E_RUN="$run_id" playwright npm run test:e2e
