#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."
temporary_directory="$(mktemp -d)"
env_file="$temporary_directory/production.env"
project="vovremya-prod-smoke-$$"
release="${VOVREMYA_IMAGE_TAG:-batch25-test}"
export VOVREMYA_ENV_FILE="$env_file"
export VOVREMYA_IMAGE_TAG="$release"
export HTTP_PORT="${PRODUCTION_SMOKE_HTTP_PORT:-18080}"
export HTTPS_PORT="${PRODUCTION_SMOKE_HTTPS_PORT:-18443}"

cleanup() {
  docker compose --project-name "$project" --env-file "$env_file" -f compose.prod.yaml down --volumes --remove-orphans >/dev/null 2>&1 || true
  rm -rf "$temporary_directory"
}
trap cleanup EXIT

umask 077
printf '%s\n' \
  "APP_DOMAIN=http://localhost" \
  "ACME_EMAIL=smoke@example.test" \
  "APP_SECRET=production-smoke-secret-with-at-least-32-characters" \
  "DEFAULT_URI=http://localhost:$HTTP_PORT" \
  "SYMFONY_TRUSTED_PROXIES=REMOTE_ADDR" \
  "DATABASE_URL=postgresql://vovremya:production-smoke-password@postgres:5432/vovremya?serverVersion=17&charset=utf8" \
  "POSTGRES_PASSWORD=production-smoke-password" \
  "REDIS_URL=redis://redis:6379" \
  "MESSENGER_TRANSPORT_DSN=redis://redis:6379" \
  "MESSENGER_CONSUMER_NAME=vovremya_smoke" \
  "INFRASTRUCTURE_HEARTBEAT_INTERVAL=5 minutes" \
  "REGULAR_SCHEDULE_HORIZON_DAYS=60" \
  "CHANNEL_ACTIVATION_TTL_SECONDS=1800" \
  "MAX_API_BASE_URL=https://platform-api2.max.ru" \
  "MAX_BOT_TOKEN=" \
  "MAX_BOT_USERNAME=" \
  "TELEGRAM_API_BASE_URL=https://api.telegram.org" \
  "TELEGRAM_BOT_TOKEN=" \
  "TELEGRAM_BOT_USERNAME=" \
  "WHATSAPP_GRAPH_API_BASE_URL=https://graph.facebook.com" \
  "WHATSAPP_GRAPH_API_VERSION=v26.0" \
  "WHATSAPP_ACCESS_TOKEN=" \
  "WHATSAPP_PHONE_NUMBER_ID=" \
  "WHATSAPP_APP_SECRET=" \
  "WHATSAPP_BUSINESS_PHONE=" > "$env_file"

compose=(docker compose --project-name "$project" --env-file "$env_file" -f compose.prod.yaml)
"${compose[@]}" up -d --no-build
"${compose[@]}" exec -T php php bin/console doctrine:schema:validate --env=prod --no-interaction
headers="$temporary_directory/headers"
body="$temporary_directory/body"
curl --fail --silent --show-error \
  --connect-timeout 3 --max-time 10 \
  --retry 12 --retry-delay 2 --retry-connrefused --retry-max-time 30 \
  --header "Host: localhost" --dump-header "$headers" --output "$body" \
  "http://127.0.0.1:$HTTP_PORT/health"
grep -Fq '"status":"ok"' "$body"
grep -Eiq '^X-Content-Type-Options: nosniff' "$headers"
grep -Eiq '^Content-Security-Policy:' "$headers"
curl --fail --silent --show-error --header "Host: localhost" --dump-header "$headers" --output "$body" "http://127.0.0.1:$HTTP_PORT/manifest.webmanifest"
grep -Eiq '^Content-Type: application/manifest\+json' "$headers"
grep -Fq '"name"' "$body"
! grep -Fq '<div id="root"></div>' "$body"
curl --fail --silent --show-error --header "Host: localhost" --output "$body" "http://127.0.0.1:$HTTP_PORT/calendar"
grep -Fq '<div id="root"></div>' "$body"
curl --fail --silent --show-error --header "Host: localhost" --output "$body" "http://127.0.0.1:$HTTP_PORT/login"
grep -Fq '<div id="root"></div>' "$body"
api_status="$(curl --silent --header "Host: localhost" --output /dev/null --write-out '%{http_code}' "http://127.0.0.1:$HTTP_PORT/api/me")"
test "$api_status" = "401"
curl --fail --silent --show-error --header "Host: localhost" --dump-header "$headers" --output "$body" "http://127.0.0.1:$HTTP_PORT/sw.js"
grep -Eiq '^Cache-Control: no-cache' "$headers"
grep -Eiq '^Content-Type: (application|text)/javascript' "$headers"
grep -Fq 'self.addEventListener' "$body"
! grep -Fq '<div id="root"></div>' "$body"
"${compose[@]}" ps --status running --services | grep -Fxq php
"${compose[@]}" ps --status running --services | grep -Fxq messenger
"${compose[@]}" ps --status running --services | grep -Fxq scheduler
"${compose[@]}" ps --status running --services | grep -Fxq caddy

echo "Production Compose smoke test passed."
